  {
   "description": "operationName wins, type from the named operation",
   "request": {
    "method": "POST",
    "url": "https://api.example.com/graphql",
    "contentType": "application/json; charset=utf-8",
    "body": "{\"operationName\":\"GetUser\",\"query\":\"query GetUser($id: ID!) { user(id: $id) { id } }\",\"variables\":{\"id\":\"1\"}}"
   },
   "expected": [
    {
     "name": "GetUser",
     "type": "query"
    }
   ]
  },
  {
   "description": "no operationName: first operation of the document",
   "request": {
    "method": "POST",
    "url": "https://api.example.com/graphql",
    "contentType": "application/json; charset=utf-8",
    "body": "{\"query\":\"query GetFeed { feed { id } } query Other { x }\"}"
   },
   "expected": [
    {
     "name": "GetFeed",
     "type": "query"
    }
   ]
  },
  {
