<!-- No permissions: in a Flutter app the native layer never opens a socket (the Dart side owns the
     connection). Release builds that turn Dürbün on need INTERNET, which networked apps already declare. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The in-app panel's session export: a read-only, unexported provider that serves only files in
             cacheDir/durbun-export, to the app a share intent grants (no androidx FileProvider needed). -->
        <provider
            android:name="dev.durbun.flutter.DurbunExportProvider"
            android:authorities="${applicationId}.durbun.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
