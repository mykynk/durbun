{
  "name": "@durbun/react-native",
  "version": "0.2.0",
  "description": "Dürbün SDK for React Native and JavaScript apps — streams logs, network and errors to the Dürbün desktop app",
  "license": "MIT",
  "author": "Muhammed Yusuf Kaynak (https://github.com/mykynk)",
  "homepage": "https://github.com/mykynk/durbun/tree/HEAD/sdks/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykynk/durbun.git",
    "directory": "sdks/js"
  },
  "bugs": {
    "url": "https://github.com/mykynk/durbun/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["react-native", "logging", "network", "debugger", "inspector", "durbun"],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/postbuild.mjs",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "ws": "^8.22.1",
    "@types/ws": "^8.18.2"
  }
}
