{
  "name": "durbun",
  "version": "0.2.0",
  "private": true,
  "description": "Dürbün — live logs, network and performance inspector for Android and iOS devices",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/server",
    "packages/ui",
    "sdks/js"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "durbun": "bin/durbun.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @durbun/ui && npm run build -w @durbun/server",
    "start": "node dist/durbun.mjs",
    "demo": "node dist/durbun.mjs --demo",
    "app": "npm --prefix apps/desktop run dev",
    "app:dist": "npm run build && npm --prefix apps/desktop run dist",
    "app:test": "npm --prefix apps/desktop test",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "app:release": "DURBUN_REPO_DIR= npm run build && npm --prefix apps/desktop run release"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "Muhammed Yusuf Kaynak",
  "homepage": "https://github.com/mykynk/durbun",
  "repository": {
    "type": "git",
    "url": "https://github.com/mykynk/durbun.git"
  },
  "bugs": {
    "url": "https://github.com/mykynk/durbun/issues"
  }
}
